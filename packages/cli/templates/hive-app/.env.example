# Hive Harness Configuration
HIVE_HOST=127.0.0.1
HIVE_PORT=18790

# Directorio de datos. HiveDB vive en <HIVE_HOME>/data.
HIVE_HOME=./.hive
# Ruta explícita de la base (opcional). ":memory:" para una base efímera.
# HIVE_DB_PATH=

# LLM Providers — <PROVIDER>_API_KEY, en mayúsculas y con el id del provider.
# La clave también se puede cargar cifrada en la base desde la app.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
# MODELSCOPE_API_KEY=ms-...
# NVIDIA_API_KEY=nvapi-...
# OPENROUTER_API_KEY=sk-or-...

# Channels (enable as needed)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=

# Logging
LOG_LEVEL=info
